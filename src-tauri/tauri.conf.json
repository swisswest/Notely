{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notely",
  "version": "0.11.0",
  "identifier": "ch.westcon.notely",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Notely",
        "width": 1120,
        "height": 740,
        "minWidth": 760,
        "minHeight": 480,
        "center": true,
        "resizable": true,
        "visible": false,
        "decorations": true
      },
      {
        "label": "quick",
        "title": "Notely Schnellerfassung",
        "width": 640,
        "height": 188,
        "center": true,
        "resizable": false,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "freezePrototype": false
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": false,
      "showMenuOnLeftClick": false,
      "tooltip": "Notely"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Westcon",
    "copyright": "",
    "category": "Productivity",
    "shortDescription": "Notizen, Aufgaben und Claude-Analyse",
    "longDescription": "Notely verbindet freie Notizen mit automatisch abgeleiteten Aufgaben und nativen Windows-Erinnerungen.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German",
          "English"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/swisswest/Notely/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU5NzVEREQ4NkMxODdGQzkKUldUSmZ4aHMyTjExV1hybzdGWlA0SWxGNGordWIybklIUjZET3VrdmFRR1d3T2prZGEwc1FJSmsK"
    }
  }
}
